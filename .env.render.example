# Copy these into Render → Web Service → Environment (not into the repo as secrets).

DISCORD_TOKEN=your_discord_bot_token

# Remote Ollama (PC Tailscale IP, Cloudflare tunnel URL, or VPS)
OLLAMA_ENABLED=1
OLLAMA_HOST=http://100.64.12.34:11434
OLLAMA_MODEL=kurumi
OLLAMA_TIMEOUT_MS=120000

# Optional: bearer token if you put auth in front of Ollama
# OLLAMA_API_KEY=

# Persona-only on Render (no Ollama machine):
# OLLAMA_ENABLED=0
