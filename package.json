{
  "name": "kurumi-voice-keeper-bot",
  "version": "1.0.0",
  "description": "Discord bot that can join the requester's voice channel and stay muted.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "ollama:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "ollama:probe": "node -e \"require('./src/local-llm').probe(true).then(r=>{console.log(r);process.exit(r.ok?0:1)})\"",
    "ollama:bind-lan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ollama-bind-lan.ps1",
    "ollama:tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ollama-tunnel.ps1",
    "ollama:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-ollama-remote.ps1",
    "render:ollama": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-render-ollama.ps1",
    "gaming:generate": "node scripts/generate-gaming-franchises.js",
    "gaming:cache": "node scripts/build-gaming-cache.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "sentiment": "^5.0.2",
    "better-sqlite3": "^11.9.1"
  }
}
