DISCORD_TOKEN=your_discord_bot_token_here

# Cloud database (Turso) — both laptop and Render share the same DB
# Sign up free at https://turso.tech, then: turso db create kurumi-bot
# TURSO_DATABASE_URL=libsql://kurumi-bot-yourname.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# Optional: comma-separated guild snowflakes — slash commands register per-server (fast). Omit for global commands.
# DISCORD_GUILD_ID=123456789012345678,987654321098765432
# Kurumi text: enable Message Content Intent in Developer Portal → Bot, then:
# USE_MESSAGE_CONTENT_INTENT=1
# “kurumi what time” uses this IANA zone when no /dailywordle schedule (India = Asia/Kolkata IST).
# DEFAULT_TIMEZONE=Asia/Kolkata

# Local LLM (Ollama) — install Ollama, then: npm run ollama:setup
# OLLAMA_ENABLED=1
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=kurumi
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_HISTORY_TURNS=16
# OLLAMA_API_KEY=

# Render / remote bot → PC or VPS (full guide: docs/ollama-remote.md)
# OLLAMA_HOST=http://100.64.12.34:11434
# OLLAMA_HOST=https://your-tunnel.trycloudflare.com  (from npm run ollama:remote → data/ollama-tunnel-url.txt)
# RENDER_API_KEY=   RENDER_SERVICE_ID=srv-...   → npm run render:ollama

# Failover: laptop sends heartbeats to Render so it takes over when laptop is offline
# RENDER_HEARTBEAT_URL=https://your-render-service.onrender.com

# Optional: online game lookups + cache build (IGDB via Twitch — api-docs.igdb.com)
# Register at https://dev.twitch.tv/console (Confidential app, redirect: localhost)
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# Aliases also work: TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET
